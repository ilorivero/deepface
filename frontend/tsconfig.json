{
  "compilerOptions": {
    "target": "ES2019",
    "module": "none",
    "lib": ["DOM", "ES2019"],
    "strict": true,
    "noEmitOnError": true,
    "removeComments": true,
    "outDir": "public/js",
    "rootDir": "ts",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["ts/**/*.ts"]
}